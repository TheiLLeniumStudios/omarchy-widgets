widget "ai usage" {
  page: 2
  order: 2
  size: 6x4
  minSize: 4x3
  meta {
    description: "Any number of Claude, OpenCode Go, OpenRouter and DeepSeek logins in one tile: usage windows, spend and remaining credit. Add, edit and remove accounts on its accounts screen"
    version: "1.0"
    license: "MIT"
    category: "dev"
    owl: 12
  }

  requires { pacman: ["curl", "jq"] }

  source now = clock every 30s
  state accounts = [] persist
  // The account list (keys included) is written to a 0600 cache file by this
  // source; the fetcher reads it. The fetcher itself comes from this widget's
  // repo and is cached for a day, so an update to it reaches the phone without
  // a new widget version.
  source u = cmd("d=$HOME/.cache/omalauncher-ai-usage; f=$d/fetch.sh; mkdir -p $d; printf '%s' ${sh(toJson(accounts))} > $d/accounts.json; chmod 600 $d/accounts.json; if [ ! -s $f ] || [ $(( $(date +%s) - $(stat -c %Y $f 2>/dev/null || echo 0) )) -gt 86400 ]; then curl -fsSL https://raw.githubusercontent.com/TheiLLeniumStudios/omarchy-widgets/main/widgets/theilleniumstudios/ai-usage/fetch.sh -o $f.tmp && mv $f.tmp $f && chmod 700 $f; fi; bash $f $d/accounts.json") every 5m json timeout 60s status

  state view = "usage"
  state formOpen = false
  state editing = ""
  state draftProvider = "claude"
  state draftName = ""
  state draftKey = ""
  state draftExtra = ""
  state formError = ""
  state confirmRemove = ""

  let d = (u != null && u.ok) ? u.out : null
  let list = d == null ? [] : (d.accounts ?? [])
  let shown = take(list, max([1, (rows ?? 4) * 2]))
  let more = len(list) - len(shown)
  let updated = d == null ? null : (d.updated ?? null)

  component PctBar(label, pct, resets = null, now = 0, compact = false) {
    Column {
      let tone = pct == null ? muted : pct >= 90 ? red : pct >= 70 ? yellow : accent
      gap: 2
      fill: width
      Row {
        gap: 3
        align: center
        fill: width
        Text { text: label; style: label; color: muted; width: compact ? 30 : 72; maxLines: 1 }
        Text { text: pct == null ? "…" : "${round(pct)}%"; style: label; color: tone; weight: 1; align: end; maxLines: 1 }
        if resets != null && resets > now {
          Text { text: fmtDuration(resets - now); style: label; color: muted; width: compact ? 44 : 62; align: end; maxLines: 1 }
        }
      }
      Progress { value: pct ?? 0; height: compact ? 4 : 6; color: tone; track: alpha(border, 0.55); fill: width }
    }
  }

  component AccountRow(a, now) {
    Column {
      let p = get(a, a.provider) ?? {}
      let pct = a.provider == "claude"
        ? max((p.limits ?? []).map(l => l.pct ?? 0))
        : a.provider == "opencode-go"
          ? max([p.rolling.pct ?? 0, p.weekly.pct ?? 0, p.monthly.pct ?? 0])
          : 0
      let low = a.provider == "openrouter"
        ? (p.remaining != null && p.remaining <= 5)
        : a.provider == "deepseek"
          ? (p.balance != null && p.balance <= 5)
          : false
      let tone = a.error != null ? red : ((pct >= 90 || low) ? red : pct >= 70 ? yellow : green)
      let bsym = p.currency == "CNY" ? "¥" : p.currency == "USD" ? "$" : ""
      let csym = (p.cost_currency ?? p.currency) == "CNY" ? "¥" : (p.cost_currency ?? p.currency) == "USD" ? "$" : ""
      Row {
        gap: 7
        align: center
        padding: [5, 7]
        border: 1
        borderColor: alpha(border, 0.5)
        radius: 7 * corners
        Spacer { width: 7; height: 7; radius: 4; background: tone }
        Column {
          gap: 3
          weight: 1
          Row {
            gap: 6
            align: center
            Text { text: a.name; style: small; weight: 1; maxLines: 1 }
            Text { text: a.provider == "opencode-go" ? "opencode go" : a.provider; style: label; color: muted; maxLines: 1 }
            if pct > 0 {
              Text { text: "${round(pct)}%"; style: label; color: tone; width: 32; align: end; maxLines: 1 }
            }
          }
          if a.error != null {
            Text { text: a.error; style: label; color: red; maxLines: 1 }
          } else if a.provider == "claude" {
            if len(p.limits ?? []) == 0 {
              Text { text: "no limits reported"; style: label; color: muted }
            } else {
              Row {
                gap: 8
                for l in take(p.limits ?? [], 2) key l.label {
                  PctBar { label: l.label; pct: l.pct; resets: l.resets; now: now; compact: true; weight: 1 }
                }
              }
            }
          } else if a.provider == "opencode-go" {
            Row {
              gap: 6
              PctBar { label: "5h"; pct: p.rolling.pct; resets: p.rolling.resets; now: now; compact: true; weight: 1 }
              PctBar { label: "wk"; pct: p.weekly.pct; resets: p.weekly.resets; now: now; compact: true; weight: 1 }
              PctBar { label: "mo"; pct: p.monthly.pct; resets: p.monthly.resets; now: now; compact: true; weight: 1 }
            }
          } else if a.provider == "openrouter" {
            Row {
              gap: 6
              align: bottom
              Text { text: p.remaining == null ? "no cap" : "$" + fixed(p.remaining, 2); style: body; color: tone; maxLines: 1 }
              Text { text: "left"; style: label; color: muted }
              Text { text: p.today == null ? "" : "today $" + fixed(p.today, 2); style: label; color: muted; weight: 1; align: end; maxLines: 1 }
            }
          } else if a.provider == "deepseek" {
            Row {
              gap: 6
              align: bottom
              Text { text: p.balance == null ? "…" : bsym + fixed(p.balance, 2); style: body; color: tone; maxLines: 1 }
              Text { text: "left"; style: label; color: muted }
              Text { text: p.today == null ? "" : "today " + (p.estimated ? "~" : "") + csym + fixed(p.today, 2); style: label; color: muted; weight: 1; align: end; maxLines: 1 }
            }
          }
        }
      }
    }
  }

  component UsageView() {
    Column {
      gap: 10
      scroll: true
      if u != null && !u.ok {
        Text { text: u.err ?? "could not run the usage fetcher"; style: small; color: red; maxLines: 3 }
      }
      if d == null {
        Text { text: "loading…"; style: body; color: muted }
      } else if len(list) == 0 {
        Column {
          gap: 10
          padding: [24, 12]
          align: center
          Text { text: "no accounts yet"; style: body; color: muted }
          Text { text: "Add a Claude login, an OpenCode Go key, an OpenRouter key or a DeepSeek key."; style: small; color: muted; align: center }
          Button {
            text: "add an account"
            color: accent
            onTap: {
              view = "config"
              formOpen = true
              editing = ""
              draftProvider = "claude"
              draftName = ""
              draftKey = ""
              draftExtra = ""
              formError = ""
            }
          }
        }
      } else {
        for a in list key a.id {
          Column {
            let p = get(a, a.provider) ?? {}
            let tone = a.error != null ? red : accent
            gap: 6
            padding: 10
            border: 1
            borderColor: alpha(border, 0.6)
            radius: 10 * corners
            Row {
              gap: 6
              align: center
              Spacer { width: 8; height: 8; radius: 4; background: tone }
              Text { text: a.name; style: body; weight: 1; maxLines: 1 }
              Text { text: a.provider == "opencode-go" ? "opencode go" : a.provider; style: label; color: muted }
            }
            if a.error != null {
              Text { text: a.error; style: small; color: red; maxLines: 2 }
            } else if a.provider == "claude" {
              Text { text: p.plan == null ? "claude code" : "plan ${p.plan}"; style: label; color: muted }
              if len(p.limits ?? []) == 0 {
                Text { text: "no limits reported"; style: small; color: muted }
              }
              for l in p.limits ?? [] key l.label {
                PctBar { label: l.label; pct: l.pct; resets: l.resets; now: now }
              }
            } else if a.provider == "opencode-go" {
              Text { text: "status ${p.status ?? "…"}"; style: label; color: muted }
              for l in [
                {label: "5h", pct: p.rolling.pct, resets: p.rolling.resets},
                {label: "week", pct: p.weekly.pct, resets: p.weekly.resets},
                {label: "month", pct: p.monthly.pct, resets: p.monthly.resets}
              ] key l.label {
                PctBar { label: l.label; pct: l.pct; resets: l.resets; now: now }
              }
            } else if a.provider == "openrouter" {
              Row {
                gap: 8
                align: bottom
                Text {
                  text: p.remaining == null ? "—" : "$" + fixed(p.remaining, 2)
                  style: huge
                  color: (p.remaining != null && p.remaining <= 5) ? red : accent
                }
                Column {
                  gap: 0
                  weight: 1
                  Text { text: "remaining"; style: label; color: muted }
                  Text {
                    text: "today $" + fixed(p.today ?? 0, 2) + " · week $" + fixed(p.week ?? 0, 2) + " · month $" + fixed(p.month ?? 0, 2)
                    style: small
                    color: muted
                    maxLines: 1
                  }
                }
              }
              Text {
                text: "key usage $" + fixed(p.usage ?? 0, 2) + (p.limit == null ? " · no key limit" : " of $" + fixed(p.limit, 2))
                style: small
                color: muted
              }
              if p.credits != null {
                Text { text: "account credits: $" + fixed(p.credits.remaining, 2) + " left of $" + fixed(p.credits.total, 2); style: small; color: muted }
              }
              if p.budget != null {
                Text { text: "budget: $" + fixed(p.budget.remaining, 2) + " left of $" + fixed(p.budget.limit, 2) + " · " + (p.budget.reset ?? ""); style: small; color: muted }
              }
              Text { text: "status ${p.status ?? "…"} · key ${p.label ?? ""}"; style: label; color: muted; maxLines: 1 }
              if p.expires != null {
                Text { text: "expires ${fmtTime(p.expires, "d MMM yyyy")}"; style: label; color: muted }
              }
              if p.rate != null {
                Text { text: "rate ${p.rate.requests} requests / ${p.rate.interval}"; style: label; color: muted }
              }
              if p.free_daily != null {
                Text { text: "free models: ${p.free_daily.used} / ${p.free_daily.limit} today"; style: label; color: muted }
              }
            } else if a.provider == "deepseek" {
              Row {
                gap: 8
                align: bottom
                Text {
                  text: p.balance == null ? "…" : (p.currency == "CNY" ? "¥" : p.currency == "USD" ? "$" : "") + fixed(p.balance, 2)
                  style: huge
                  color: (p.balance != null && p.balance <= 5) ? red : accent
                }
                Column {
                  gap: 0
                  weight: 1
                  Text { text: "remaining"; style: label; color: muted }
                  Text { text: (p.available ? "available" : "not available") + " · " + (p.currency ?? ""); style: small; color: muted }
                }
              }
              Text {
                text: (p.estimated ? "estimated spend · " : "spend · ") + "today " + (p.cost_currency ?? p.currency ?? "") + " " + fixed(p.today ?? 0, 2) + " · month " + (p.cost_currency ?? p.currency ?? "") + " " + fixed(p.month ?? 0, 2)
                style: small
                color: muted
                maxLines: 2
              }
              if p.today_tokens != null {
                Text { text: "today ${fmtNum(p.today_tokens)} tokens"; style: small; color: muted }
              }
              if p.usage_error != null {
                Text { text: p.usage_error; style: label; color: yellow; maxLines: 2 }
              }
              for b in p.balances ?? [] key b.currency {
                Text { text: "${b.currency}: ${fixed(b.total, 2)} (granted ${fixed(b.granted, 2)}, topped ${fixed(b.topped, 2)})"; style: label; color: muted; maxLines: 1 }
              }
            }
          }
        }
        if updated != null {
          Text { text: "updated ${fmtTime(updated, "HH:mm")} · ${fmtAgo(updated, now)}"; style: label; color: muted; align: center }
        }
      }
    }
  }

  component ConfigView() {
    Column {
      gap: 10
      scroll: true
      Text { text: "Keys are saved in this widget's state, not in the .owl file. They are sent only to the local fetcher and the provider."; style: label; color: muted }
      if !formOpen {
        if len(accounts) == 0 {
          Text { text: "no accounts yet"; style: body; color: muted }
        }
        for a, i in accounts key a.id {
          Column {
            let f = find(list, x => x.id == a.id) ?? {}
            gap: 6
            padding: 8
            border: 1
            borderColor: alpha(border, 0.55)
            radius: 8 * corners
            Row {
              gap: 6
              align: center
              Spacer { width: 7; height: 7; radius: 4; background: f.error == null ? accent : red }
              Column {
                gap: 0
                weight: 1
                Text { text: a.name; style: small; maxLines: 1 }
                Text { text: (a.provider == "opencode-go" ? "opencode go" : a.provider) + (a.key == "" ? " · default login" : " · key set"); style: label; color: muted; maxLines: 1 }
              }
              if i > 0 {
                Text { text: "↑"; style: body; color: muted; padding: [6, 4]; onTap: { accounts = set(set(accounts, i, accounts[i - 1]), i - 1, a) } }
              }
              if i < len(accounts) - 1 {
                Text { text: "↓"; style: body; color: muted; padding: [6, 4]; onTap: { accounts = set(set(accounts, i, accounts[i + 1]), i + 1, a) } }
              }
              Text {
                text: "edit"
                style: small
                color: accent
                padding: [6, 4]
                onTap: {
                  editing = a.id
                  draftProvider = a.provider
                  draftName = a.name
                  draftKey = a.key
                  draftExtra = a.extra ?? ""
                  formError = ""
                  formOpen = true
                  confirmRemove = ""
                }
              }
              Text { text: "remove"; style: small; color: red; padding: [6, 4]; onTap: confirmRemove = a.id }
            }
            if confirmRemove == a.id {
              Row {
                gap: 6
                align: center
                Text { text: "remove ${a.name}?"; style: label; color: muted; weight: 1 }
                Button { text: "yes"; color: red; onTap: { accounts = accounts.filter(x => x.id != a.id); confirmRemove = "" } }
                Button { text: "no"; color: muted; onTap: confirmRemove = "" }
              }
            }
          }
        }
        Button {
          text: "add account"
          color: accent
          onTap: {
            formOpen = true
            editing = ""
            draftProvider = "claude"
            draftName = ""
            draftKey = ""
            draftExtra = ""
            formError = ""
            confirmRemove = ""
          }
        }
      } else {
        Column {
          gap: 8
          padding: 10
          border: 1
          borderColor: accent
          radius: 10 * corners
          Text { text: editing == "" ? "add account" : "edit account"; style: body; color: accent }
          Text { text: "provider"; style: label; color: muted }
          Flow {
            gap: 4
            for pr in ["claude", "opencode-go", "openrouter", "deepseek"] key pr {
              Text {
                text: pr == "opencode-go" ? "opencode go" : pr
                style: small
                color: pr == draftProvider ? accent : foreground
                padding: [7, 9]
                border: 1
                borderColor: pr == draftProvider ? accent : alpha(border, 0.6)
                radius: 6 * corners
                onTap: { draftProvider = pr; draftKey = ""; draftExtra = ""; formError = "" }
              }
            }
          }
          Text { text: "name"; style: label; color: muted }
          Input { text: draftName; placeholder: "name (optional)"; onChange: draftName = value }
          Text { text: "key"; style: label; color: muted }
          Input {
            text: draftKey
            placeholder: draftProvider == "claude" ? "path to .credentials.json or OAuth token" : draftProvider == "opencode-go" ? "OpenCode Go API key" : draftProvider == "openrouter" ? "OpenRouter API key" : "DeepSeek API key"
            onChange: draftKey = value
          }
          if draftProvider == "claude" {
            Text { text: "blank uses ~/.claude/.credentials.json. For a second login: CLAUDE_CONFIG_DIR=~/.claude-2 claude"; style: label; color: muted; maxLines: 2 }
          }
          if draftProvider == "openrouter" || draftProvider == "deepseek" {
            Text { text: draftProvider == "openrouter" ? "management key (optional)" : "usage token (optional)"; style: label; color: muted }
            Input {
              text: draftExtra
              placeholder: draftProvider == "openrouter" ? "account-wide credits" : "exact daily/monthly spend"
              onChange: draftExtra = value
            }
          }
          if formError != "" {
            Text { text: formError; style: small; color: red }
          }
          Row {
            gap: 8
            Button {
              text: "save"
              color: accent
              onTap: {
                formError = (draftProvider != "claude" && trim(draftKey) == "") ? "a key is required" : ""
                accounts = formError != "" ? accounts : (editing != "" ? accounts.map(a => a.id == editing ? {id: editing, provider: draftProvider, name: trim(draftName) == "" ? draftProvider : trim(draftName), key: trim(draftKey), extra: trim(draftExtra)} : a) : accounts + [{id: "${now}-${random(1000000)}", provider: draftProvider, name: trim(draftName) == "" ? draftProvider : trim(draftName), key: trim(draftKey), extra: trim(draftExtra)}])
                formOpen = formError != ""
                editing = formError != "" ? editing : ""
                draftName = formError != "" ? draftName : ""
                draftKey = formError != "" ? draftKey : ""
                draftExtra = formError != "" ? draftExtra : ""
              }
            }
            Button {
              text: "cancel"
              color: muted
              onTap: { formOpen = false; formError = "" }
            }
          }
        }
      }
    }
  }

  onTap: { view = "usage"; screen() }

  Column {
    gap: 6
    Row {
      gap: 8
      align: center
      Text { text: "ai usage"; style: label; color: accent; weight: 1 }
      if u != null && !u.ok {
        Text { text: "fetch failed"; style: label; color: red }
      } else if updated != null {
        Text { text: "updated ${fmtAgo(updated, now)}"; style: label; color: muted }
      } else {
        Text { text: "loading…"; style: label; color: muted }
      }
      Text {
        text: "accounts"
        style: label
        color: accent
        padding: [6, 2]
        onTap: { view = "config"; formOpen = false; formError = ""; screen() }
      }
    }
    if d == null {
      if u != null && !u.ok {
        Text { text: u.err ?? "could not run the usage fetcher"; style: small; color: muted; maxLines: 2 }
      } else {
        Text { text: "loading…"; style: small; color: muted }
      }
    } else if len(list) == 0 {
      Column {
        gap: 8
        weight: 1
        align: center
        justify: center
        Text { text: "no accounts yet"; style: body; color: muted }
        Text { text: "add any number of Claude, OpenCode Go, OpenRouter or DeepSeek logins"; style: label; color: muted; align: center }
        Button {
          text: "add an account"
          color: accent
          onTap: {
            view = "config"
            formOpen = true
            editing = ""
            draftProvider = "claude"
            draftName = ""
            draftKey = ""
            draftExtra = ""
            formError = ""
            screen()
          }
        }
      }
    } else {
      Column {
        gap: 5
        weight: 1
        clip: true
        for a in shown key a.id {
          AccountRow { a: a; now: now }
        }
        if more > 0 {
          Text { text: "+${more} more · tap for all"; style: label; color: muted; align: center }
        }
      }
    }
  }

  screen {
    title: "ai usage"
    Column {
      gap: 10
      padding: 2
      Row {
        gap: 8
        align: center
        Text { text: view == "config" ? "accounts" : "usage"; style: title; weight: 1 }
        if view == "usage" {
          Button { text: "accounts"; color: accent; onTap: { view = "config"; formOpen = false; formError = "" } }
        } else {
          Button { text: "usage"; color: accent; onTap: { view = "usage"; formOpen = false; formError = "" } }
        }
        Button { text: "refresh"; color: muted; onTap: refresh() }
      }
      if view == "config" {
        ConfigView { }
      } else {
        UsageView { }
      }
    }
  }
}
